{
  "opencollection": "1.0.0",
  "info": {
    "name": "DriveWealth Accounts Virtual Bank Accounts API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Virtual Bank Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Account Virtual Bank Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bo-api.drivewealth.io/back-office/accounts/:accountID/funding/deposit-instructions",
            "params": [
              {
                "name": "accountID",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves an Account Virtual Bank Account details by accountID."
        }
      ]
    }
  ],
  "bundled": true
}