          "http": {
            "method": "GET",
            "url": "https://bo-api.drivewealth.io/back-office/accounts/:accountID/reports/daily-trade-summary",
            "params": [
              {
                "name": "accountID",
                "value": "",
                "type": "path"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "A filter, to filter on the status of the DVP/RVP."
              },
              {
                "name": "from",
                "value": "",
                "type": "query"
              },
              {
                "name": "to",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists DVP RVP reports."
        },
        {
          "info": {
            "name": "Create DVP RVP Report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://bo-api.drivewealth.io/back-office/accounts/:accountID/reports/daily-trade-summary",
            "params": [
              {
                "name": "accountID",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a job to generate a DVP RVP Report."
        },
        {
          "info": {
            "name": "Retrieve DVP RVP",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bo-api.drivewealth.io/back-office/accounts/:accountID/reports/daily-trade-summary/:reportID",
            "params": [
              {
                "name": "accountID",
                "value": "",
                "type": "path"
              },
              {
                "name": "reportID",
