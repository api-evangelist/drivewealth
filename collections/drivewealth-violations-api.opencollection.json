{
  "opencollection": "1.0.0",
  "info": {
    "name": "DriveWealth Accounts Violations API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Violations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Account Violations Summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bo-api.drivewealth.io/back-office/accounts/:accountID/summary/violations",
            "params": [
              {
                "name": "accountID",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrives Account Violations Summary details by accountID."
        },
        {
          "info": {
            "name": "List Account Violations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bo-api.drivewealth.io/back-office/accounts/:accountID/violations",
            "params": [
              {
                "name": "accountID",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrives a list of Account Violations by accountID."
        }
      ]
    }
  ],
  "bundled": true
}